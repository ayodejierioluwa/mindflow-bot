# ==========================================
# Telegram Bot Configuration
# ==========================================
# Obtain from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ==========================================
# AI Model APIs (Choose Groq, Gemini, or OpenAI)
# ==========================================
# Groq provides lightning-fast (<1s) & free/ultra-cheap Whisper transcription
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API key (generous free tier for multimodal & structured LLM parsing)
GEMINI_API_KEY=your_gemini_api_key_here

# (Optional fallback) OpenAI API key
OPENAI_API_KEY=your_openai_api_key_here

# ==========================================
# External Integrations (Optional / Staged)
# ==========================================
NOTION_API_KEY=
NOTION_DATABASE_ID=
